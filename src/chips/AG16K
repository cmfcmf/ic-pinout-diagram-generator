name: "AGM AG16K (+MCU)"
manufacturer: "AGM Micro"
description: "16K LUTs FPGA + 250MHz MCU SoC. Embedded CPLD logic used for RS-485 Auto-Direction."
# 封装定义
packages:
  - name: "LQFP-144"
    pins:
      # 电源部分
      1: { label: "GND", type: "power" }
      2: { label: "VDDIO1", type: "power" }
      7: { label: "VDDC (1.2V)", type: "power" }
      # FPGA 配置引脚
      8: { label: "ASDO/DATA1", type: "spi" }
      9: { label: "nCSO", type: "spi" }
      15: { label: "DCLK", type: "spi" }
      16: { label: "DATA0", type: "spi" }
      # JTAG / Debug
      18: { label: "TDI", type: "jtag" }
      19: { label: "TCK", type: "jtag" }
      21: { label: "TMS", type: "jtag" }
      22: { label: "TDO", type: "jtag" }
      23: { label: "SWCLK (MCU)", type: "debug" }
      24: { label: "SWDIO (MCU)", type: "debug" }
      # 重点：通过 CPLD 逻辑实现的 485 功能映射
      40: { label: "RS485_TXD", type: "uart", description: "MCU UART TX routed via CPLD" }
      41: { label: "RS485_RXD", type: "uart", description: "MCU UART RX routed via CPLD" }
      42: { label: "RS485_DIR", type: "io", description: "Auto-direction signal generated by Logic" }
      
      73: { label: "GND", type: "power" }
      144: { label: "IO_144", type: "io" }

# 侧边栏分组显示
groups:
  - name: "RS-485 System (CPLD Logic)"
    color: "#e67e22"
    pins: [40, 41, 42]
  - name: "Power"
    color: "#e74c3c"
    pins: [1, 2, 7, 73]
  - name: "MCU Debug"
    color: "#3498db"
    pins: [23, 24]
  - name: "FPGA Config"
    color: "#27ae60"
    pins: [8, 9, 15, 16, 18, 19, 21, 22]
